NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fortis_dev
# DigitalOcean managed Postgres needs TLS:
DATABASE_SSL=false
WEB_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
SESSION_TTL_DAYS=14
# Generate with: pnpm --filter @fortis/api keys:rules  (required in production)
RULES_SIGNING_PRIVATE_KEY=
RULES_SIGNING_KEY_ID=dev
